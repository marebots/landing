---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';

const useCases = [
  {
    title: 'Retomar pedidos sem resposta',
    body: 'Orçamento ou pedido parado? O funcionário digital lembra o cliente no prazo combinado, no tom da sua empresa — para nada morrer na caixa de entrada.',
  },
  {
    title: 'Resumo diário do que chegou',
    body: 'De manhã você recebe: o que é urgente, o que é pedido novo, o que é reclamação e o que pode esperar.',
  },
  {
    title: 'Números da semana',
    body: 'Quantos pedidos entraram, quanto tempo levou para responder e o que virou negócio — para decidir com clareza.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Conversa rápida',
    body: 'Quinze minutos: de onde vêm os pedidos hoje e o que mais trava a manhã.',
  },
  {
    n: '2',
    title: 'Combinamos o jeito',
    body: 'Prioridades, tom de voz da sua empresa e o que precisa da sua aprovação.',
  },
  {
    n: '3',
    title: 'Rotina nos bastidores',
    body: 'Organiza e-mails, pedidos e reservas; cobra resposta no prazo — você cuida do cliente.',
  },
  {
    n: '4',
    title: 'Você decide',
    body: 'Olhamos os números juntos. Se fizer sentido, continua. Se não, para sem drama.',
  },
];

const sectors = [
  'Pousadas e hotéis pequenos',
  'Agências de receptivo',
  'Lojas online',
  'Prestadores locais',
  'Turismo e experiências',
  'Clínicas e serviços',
];
---

<Layout>
  <!-- Header -->
  <header class="sticky top-0 z-40 border-b border-mangue/10 bg-sand/90 backdrop-blur-md">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3.5">
      <a href="#" class="flex items-center gap-2.5 font-semibold tracking-tight text-mangue-deep">
        <img
          src="/logo-icon.png"
          alt=""
          width="36"
          height="36"
          class="size-9 rounded-lg bg-white shadow-sm ring-1 ring-mangue/10"
        />
        <span class="text-lg">MaréBots</span>
      </a>
      <nav class="flex items-center gap-3 text-sm font-medium">
        <a
          href="#piloto"
          class="hidden text-ink/70 transition hover:text-mangue sm:inline"
          >Piloto Pipa</a
        >
        <a
          href="#contato"
          class="rounded-lg bg-mangue px-3.5 py-2 text-white transition hover:bg-mangue-deep"
          >Falar conosco</a
        >
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-mangue-deep via-mangue to-[#1e6b56] text-white">
    <div
      class="pointer-events-none absolute inset-0 opacity-30"
      style="background-image: radial-gradient(ellipse 80% 50% at 70% -10%, #8FDB6C55, transparent);"
    >
    </div>
    <div class="relative mx-auto max-w-5xl px-5 pb-16 pt-14 md:pb-24 md:pt-20">
      <p class="mb-4 text-sm font-medium tracking-wide text-mint-light/90">
        MaréBots · funcionário digital para o dia a dia
      </p>
      <h1 class="max-w-3xl text-3xl font-bold leading-[1.15] tracking-tight sm:text-4xl md:text-5xl">
        Menos pedido parado.<br class="hidden sm:block" /> Mais tempo para o que importa.
      </h1>
      <p class="mt-5 max-w-2xl text-lg font-medium leading-relaxed text-white/95 md:text-xl">
        Um funcionário digital que organiza e-mails, pedidos e reservas — e cobra resposta no prazo —
        enquanto você cuida do cliente.
      </p>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/85 md:text-lg">
        A MaréBots ajuda pequenas e médias empresas a não perder negócio por demora no retorno.
        Separa o que é urgente, retoma contatos que esfriaram e manda um resumo claro todo dia.
        Você aprova o que for sensível.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#contato"
          class="inline-flex items-center justify-center rounded-xl bg-mint px-6 py-3.5 text-base font-semibold text-white shadow-md transition hover:bg-mint-light hover:text-mangue-deep"
        >
          Quero organizar minha rotina
        </a>
        <a
          href="#piloto"
          class="text-sm font-medium text-white/90 underline decoration-white/40 underline-offset-4 transition hover:decoration-mint-light"
        >
          Ver o piloto em Pipa →
        </a>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="py-16 md:py-24" id="rotinas">
    <div class="mx-auto max-w-5xl px-5">
      <h2 class="text-2xl font-bold tracking-tight text-mangue-deep md:text-3xl">
        O que a gente faz no dia a dia
      </h2>
      <p class="mt-3 max-w-2xl text-ink/80">
        Três rotinas que se repetem em quase todo negócio — e que costumam roubar a manhã da equipe.
      </p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          useCases.map((c) => (
            <article class="rounded-2xl border border-mangue/8 bg-white p-6 shadow-sm">
              <div class="mb-4 flex size-10 items-center justify-center rounded-xl bg-mint/15 text-mangue">
                <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-mangue-deep">{c.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/75">{c.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="border-y border-mangue/8 bg-white py-16 md:py-24" id="como">
    <div class="mx-auto max-w-5xl px-5">
      <h2 class="text-2xl font-bold tracking-tight text-mangue-deep md:text-3xl">Como funciona</h2>
      <p class="mt-3 max-w-2xl text-ink/80">
        Começa simples: uma rotina clara, com você no controle.
      </p>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s) => (
            <li class="relative">
              <span class="mb-3 inline-flex size-9 items-center justify-center rounded-full bg-mangue text-sm font-bold text-white">
                {s.n}
              </span>
              <h3 class="font-semibold text-mangue-deep">{s.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink/75">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Sectors chips -->
  <section class="py-14 md:py-16" id="para-quem">
    <div class="mx-auto max-w-5xl px-5">
      <h2 class="text-2xl font-bold tracking-tight text-mangue-deep md:text-3xl">Para quem é</h2>
      <p class="mt-3 max-w-2xl text-ink/80">
        Falamos com quem decide na empresa. O hóspede ou cliente final continua falando com você —
        a MaréBots trabalha nos bastidores.
      </p>
      <ul class="mt-8 flex flex-wrap gap-2.5">
        {
          sectors.map((s) => (
            <li class="rounded-full border border-mangue/15 bg-white px-4 py-2 text-sm font-medium text-mangue-deep shadow-sm">
              {s}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Anti-section -->
  <section class="pb-8 md:pb-12">
    <div class="mx-auto max-w-5xl px-5">
      <div
        class="rounded-2xl border border-mangue/10 bg-white p-6 shadow-sm md:p-8"
        style="border-left: 4px solid #6BCB4A;"
      >
        <h2 class="text-lg font-bold text-mangue-deep md:text-xl">
          Não é um robô respondendo sozinho no WhatsApp
        </h2>
        <p class="mt-3 max-w-3xl text-ink/80 leading-relaxed">
          Não conversamos com o hóspede ou cliente final no seu lugar, não mandamos mensagem em massa
          e não mexemos em pagamento. Trabalhamos no e-mail e nos canais de pedido/reserva que você
          autorizar, com acesso mínimo e combinado por escrito.
        </p>
      </div>
    </div>
  </section>

  <!-- Pilot Pipa (removable) -->
  <section id="piloto" class="scroll-mt-24 py-12 md:py-16">
    <div class="mx-auto max-w-5xl px-5">
      <div class="rounded-2xl bg-gradient-to-br from-mangue-deep to-mangue p-7 text-white shadow-lg md:p-10">
        <span
          class="inline-block rounded-full bg-white/15 px-3 py-1 text-xs font-semibold tracking-wide text-mint-light"
        >
          Piloto agora · Praia da Pipa, RN
        </span>
        <h2 class="mt-4 text-2xl font-bold tracking-tight md:text-3xl">
          Pousadas de médio porte (cerca de 15 a 40 quartos)
        </h2>
        <p class="mt-3 max-w-2xl text-white/90">
          Poucas vagas, valor simbólico, em troca do seu feedback. Quatorze dias com você aprovando o
          que for delicado. Faz sentido se você recebe pedidos por e-mail e pelos sites de reserva —
          e sente que na alta alguma cotação se perde.
        </p>
        <ul class="mt-6 space-y-2 text-sm text-white/85 md:text-base">
          <li>· Conversa de 15 minutos: de onde vêm os pedidos hoje.</li>
          <li>· Combinamos prioridades e o jeito de falar da sua pousada.</li>
          <li>· Quatorze dias de rotina com você no controle.</li>
          <li>· No fim, olhamos os números juntos e você decide se continua.</li>
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#contato"
            class="inline-flex rounded-xl bg-mint px-5 py-3 font-semibold text-white transition hover:bg-mint-light hover:text-mangue-deep"
            data-set-fonte="piloto"
            id="cta-piloto"
          >
            Quero falar do piloto
          </a>
          <a
            href="mailto:contato@marebots.com?subject=Piloto%20Mar%C3%A9Bots%20Pipa%20pousadas"
            class="inline-flex rounded-xl border border-white/30 px-5 py-3 font-medium text-white/95 transition hover:bg-white/10"
          >
            Ou escrever por e-mail
          </a>
        </div>
        <p class="mt-5 text-sm text-white/65">
          Cliente da MaréBots = a pousada (B2B). Hóspede = continua sendo atendido por vocês.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact form -->
  <div class="border-t border-mangue/8 bg-white">
    <LeadForm
      id="contato"
      fonteDefault="landing"
      heading="Fale com a MaréBots"
      subheading="Conta o que trava no dia a dia. Respondemos em horário comercial (Brasília)."
    />
  </div>

  <!-- Footer -->
  <footer class="border-t border-mangue/10 bg-sand py-10">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-3 px-5 text-center text-sm text-ink/65">
      <div class="flex items-center gap-2 font-semibold text-mangue-deep">
        <img src="/logo-icon.png" alt="" width="24" height="24" class="size-6 rounded-md" />
        MaréBots
      </div>
      <p>
        Funcionário digital para pequenas e médias empresas ·
        <a href="mailto:contato@marebots.com" class="underline decoration-mangue/30 underline-offset-2 hover:text-mangue"
          >contato@marebots.com</a
        >
        ·
        <a href="https://instagram.com/marebots" class="underline decoration-mangue/30 underline-offset-2 hover:text-mangue"
          >@marebots</a
        >
      </p>
      <p class="text-xs text-ink/50">© {new Date().getFullYear()} MaréBots · marebots.com</p>
    </div>
  </footer>
</Layout>

<script>
  // When clicking pilot CTA, set hidden fonte on the contact form
  document.getElementById('cta-piloto')?.addEventListener('click', () => {
    const form = document.querySelector<HTMLFormElement>('#contato-form');
    const fonte = form?.querySelector<HTMLInputElement>('input[name="fonte"]');
    if (form && fonte) {
      fonte.value = 'piloto';
      form.dataset.fonte = 'piloto';
    }
  });
</script>
