---
interface Props {
  id?: string;
  fonteDefault?: string;
  heading?: string;
  subheading?: string;
}

const {
  id = 'contato',
  fonteDefault = 'landing',
  heading = 'Fale com a MaréBots',
  subheading = 'Conta o que trava no dia a dia. Respondemos em horário comercial (Brasília).',
} = Astro.props;
---

<section id={id} class="scroll-mt-24 py-16 md:py-24">
  <div class="mx-auto max-w-xl px-5">
    <h2 class="text-2xl font-bold tracking-tight text-mangue-deep md:text-3xl">
      {heading}
    </h2>
    <p class="mt-3 text-ink/80">{subheading}</p>

    <form
      id={`${id}-form`}
      class="mt-8 space-y-4"
      data-lead-form
      data-fonte={fonteDefault}
      novalidate
    >
      <input type="hidden" name="fonte" value={fonteDefault} />

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block sm:col-span-1">
          <span class="mb-1.5 block text-sm font-medium text-ink">Nome *</span>
          <input
            type="text"
            name="nome"
            required
            autocomplete="name"
            class="w-full rounded-xl border border-mangue/15 bg-white px-3.5 py-2.5 text-ink outline-none ring-mint/40 transition focus:border-mangue/40 focus:ring-2"
            placeholder="Seu nome"
          />
        </label>
        <label class="block sm:col-span-1">
          <span class="mb-1.5 block text-sm font-medium text-ink">Empresa *</span>
          <input
            type="text"
            name="empresa"
            required
            autocomplete="organization"
            class="w-full rounded-xl border border-mangue/15 bg-white px-3.5 py-2.5 text-ink outline-none ring-mint/40 transition focus:border-mangue/40 focus:ring-2"
            placeholder="Nome do negócio"
          />
        </label>
      </div>

      <label class="block">
        <span class="mb-1.5 block text-sm font-medium text-ink"
          >Cidade / UF <span class="font-normal text-ink/50">(opcional)</span></span
        >
        <input
          type="text"
          name="cidade"
          autocomplete="address-level2"
          class="w-full rounded-xl border border-mangue/15 bg-white px-3.5 py-2.5 text-ink outline-none ring-mint/40 transition focus:border-mangue/40 focus:ring-2"
          placeholder="Ex.: Tibau do Sul / RN"
        />
      </label>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium text-ink">E-mail *</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            class="w-full rounded-xl border border-mangue/15 bg-white px-3.5 py-2.5 text-ink outline-none ring-mint/40 transition focus:border-mangue/40 focus:ring-2"
            placeholder="voce@empresa.com"
          />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium text-ink"
            >WhatsApp <span class="font-normal text-ink/50">(opcional)</span></span
          >
          <input
            type="tel"
            name="whatsapp"
            autocomplete="tel"
            class="w-full rounded-xl border border-mangue/15 bg-white px-3.5 py-2.5 text-ink outline-none ring-mint/40 transition focus:border-mangue/40 focus:ring-2"
            placeholder="(84) 99999-0000"
          />
        </label>
      </div>

      <label class="block">
        <span class="mb-1.5 block text-sm font-medium text-ink"
          >O que trava hoje? *</span
        >
        <textarea
          name="dor"
          required
          rows="4"
          class="w-full resize-y rounded-xl border border-mangue/15 bg-white px-3.5 py-2.5 text-ink outline-none ring-mint/40 transition focus:border-mangue/40 focus:ring-2"
          placeholder="Ex.: cotações por e-mail que ficam sem resposta na alta…"
        ></textarea>
      </label>

      <label class="flex items-start gap-3 text-sm text-ink/80">
        <input
          type="checkbox"
          name="consent"
          required
          class="mt-1 size-4 shrink-0 rounded border-mangue/30 text-mangue accent-mangue"
        />
        <span
          >Autorizo a MaréBots a usar meus dados para responder este contato, conforme a LGPD. Não enviamos spam.</span
        >
      </label>

      <div data-form-status class="hidden rounded-xl px-4 py-3 text-sm" role="status"></div>

      <button
        type="submit"
        data-submit
        class="inline-flex w-full items-center justify-center rounded-xl bg-mint px-6 py-3.5 text-base font-semibold text-white shadow-sm transition hover:bg-mint-light hover:text-mangue-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mangue disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
      >
        Enviar mensagem
      </button>
    </form>
  </div>
</section>

<script>
  function initLeadForms() {
    document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
      if (form.dataset.bound === '1') return;
      form.dataset.bound = '1';

      const statusEl = form.querySelector<HTMLElement>('[data-form-status]');
      const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!statusEl || !submitBtn) return;

        const fd = new FormData(form);
        const consent = fd.get('consent') === 'on';
        if (!consent) {
          showStatus(statusEl, 'error', 'Marque o consentimento LGPD para continuar.');
          return;
        }

        const payload = {
          nome: String(fd.get('nome') || '').trim(),
          empresa: String(fd.get('empresa') || '').trim(),
          cidade: String(fd.get('cidade') || '').trim(),
          email: String(fd.get('email') || '').trim(),
          whatsapp: String(fd.get('whatsapp') || '').trim(),
          dor: String(fd.get('dor') || '').trim(),
          fonte: String(fd.get('fonte') || form.dataset.fonte || 'landing').trim(),
          consent: true,
        };

        if (!payload.nome || !payload.empresa || !payload.email || !payload.dor) {
          showStatus(statusEl, 'error', 'Preencha nome, empresa, e-mail e o que trava hoje.');
          return;
        }

        submitBtn.disabled = true;
        const original = submitBtn.textContent;
        submitBtn.textContent = 'Enviando…';
        showStatus(statusEl, 'pending', 'Enviando…');

        try {
          const res = await fetch('/api/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
          if (!res.ok || !data.ok) {
            throw new Error(data.error || 'Não foi possível enviar. Tente de novo ou escreva para contato@marebots.com.');
          }
          form.reset();
          const fonteInput = form.querySelector<HTMLInputElement>('input[name="fonte"]');
          if (fonteInput) fonteInput.value = form.dataset.fonte || 'landing';
          showStatus(
            statusEl,
            'success',
            'Recebemos! Em breve alguém da MaréBots responde no seu e-mail.',
          );
        } catch (err) {
          const msg =
            err instanceof Error
              ? err.message
              : 'Algo deu errado. Escreva para contato@marebots.com.';
          showStatus(statusEl, 'error', msg);
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = original || 'Enviar mensagem';
        }
      });
    });
  }

  function showStatus(
    el: HTMLElement,
    kind: 'success' | 'error' | 'pending',
    message: string,
  ) {
    el.classList.remove('hidden', 'bg-mint/15', 'text-mangue-deep', 'bg-red-50', 'text-red-800', 'bg-white', 'text-ink/70');
    if (kind === 'success') {
      el.classList.add('bg-mint/15', 'text-mangue-deep');
    } else if (kind === 'error') {
      el.classList.add('bg-red-50', 'text-red-800');
    } else {
      el.classList.add('bg-white', 'text-ink/70');
    }
    el.textContent = message;
  }

  initLeadForms();
  document.addEventListener('astro:page-load', initLeadForms);
</script>
