# Local notes / `wrangler dev` (.dev.vars). Never commit real keys.
# Production secrets live in the Cloudflare Worker dashboard (RESEND is the only required secret).

# Resend — send as contato@marebots.com (domain verified in Resend)
RESEND_API_KEY=re_xxxxxxxx

# Who receives new-lead alerts (also set as a plain Worker var in wrangler.jsonc)
LEAD_NOTIFY_TO=marebots.com@gmail.com

# Optional: Google Apps Script Web App URL → Leads sheet
# See docs/leads-apps-script.md
LEADS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Keep Wrangler telemetry off in this project (also set in npm scripts)
WRANGLER_SEND_METRICS=false
