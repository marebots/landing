# Copy to .env for local notes only — Pages Functions read CF dashboard secrets.
# Never commit real keys.

# Resend (https://resend.com) — send as contato@marebots.com (verify domain)
RESEND_API_KEY=re_xxxxxxxx

# Who receives new-lead alerts (default: marebots.com@gmail.com)
LEAD_NOTIFY_TO=marebots.com@gmail.com

# Optional: Google Apps Script Web App URL that appends to the Leads sheet
# See docs/leads-apps-script.md
LEADS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
